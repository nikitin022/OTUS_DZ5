# Переменные окружения фронтенда «Капля» (Vite).
# Скопируйте файл в .env и подставьте значения вашего проекта Supabase.
# Файл .env не коммитится (см. .gitignore).

# URL проекта Supabase (публичный адрес API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable (anon) ключ проекта — предназначен для использования в браузере.
# Безопасность данных обеспечивается политиками RLS, а не секретностью ключа.
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# ВАЖНО: service_role-ключ и пароль БД в это окружение НЕ включаются.
# Они предназначены только для серверного контура (Edge Functions, дашборд Supabase)
# и обходят Row Level Security.